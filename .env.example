# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Auth / Postgres
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_PROOF_BUCKET="task-proofs"
R2_AVATAR_BUCKET="avatars"
R2_PROOF_PUBLIC_BASE_URL="https://files.example.com"
R2_AVATAR_PUBLIC_BASE_URL="https://avatars.example.com"

# Prisma / Supabase Postgres
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.your-project:your-password@db.your-project.supabase.co:5432/postgres"

# Email SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-gmail

# Analytics
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Scheduled jobs / external cron
CRON_SECRET="replace-with-a-long-random-secret"

# Payments / SePay bank transfer
# Public webhook URL to configure in SePay: https://your-domain.com/api/payments/sepay/webhook
SEPAY_API_TOKEN="your-sepay-api-token"
SEPAY_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
SEPAY_MERCHANT_ID="your-sepay-merchant-id"
SEPAY_BANK_NAME="Ngân hàng TMCP Ngoại thương Việt Nam"
SEPAY_BANK_SHORT_NAME="VCB"
SEPAY_BANK_ACCOUNT_NUMBER="0123456789"
SEPAY_BANK_ACCOUNT_NAME="CONG TY TNHH TASKBEE"

# Payments / USDT deposits
# Use a production blockchain webhook/reconciliation provider. Do not credit balances from client-submitted tx hashes.
USDT_PROVIDER_API_KEY="your-chain-provider-api-key"
USDT_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
USDT_TRC20_DEPOSIT_ADDRESS="Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
USDT_BEP20_DEPOSIT_ADDRESS="0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
USDT_ERC20_DEPOSIT_ADDRESS="0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
